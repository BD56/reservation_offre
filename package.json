{
  "name": "reservation-offre",
  "version": "1.0.0",
  "private": true,
  "description": "Réservations des offres (Google Apps Script) : outils de développement uniquement, rien ici n'est envoyé à Apps Script.",
  "scripts": {
    "test": "bash tests/lancer.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nouvelle-version": "node outils/version.js",
    "verifier-version": "node outils/version.js --verifier",
    "push": "node outils/version.js --verifier && clasp push",
    "status": "clasp status"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "eslint": "^10.12.0",
    "eslint-plugin-html": "^8.2.1",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10"
  }
}
